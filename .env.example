# Copy this file to ".env" (same folder) and fill in your real key.
# .env is never committed and never appears in the submitted zip.

OPENAI_API_KEY=sk-your-key-here

# Model IDs, per capstone_build_plan.md §0.2 / §9 (confirmed 25 Aug 2026).
OPENAI_MODEL_AGENT=gpt-4o-mini
OPENAI_MODEL_JUDGE=gpt-4o

# LangSmith tracing -- optional, OFF by default. Deliberately not named
# LANGCHAIN_TRACING_V2 / LANGSMITH_TRACING: setting either of those names
# would switch on LangChain's own unredacted global auto-tracer alongside
# ours. See src/langsmith_tracing.py and Phase_8/docs/08_deployment.md for
# why. Set to true and fill in your own LangSmith key to enable.
ENABLE_SAFE_LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=lsv2-your-langsmith-key-here
LANGCHAIN_PROJECT=bankassist-advisor
