# Copy this file to ".env" (same folder) and fill in your real key.
# .env is never committed and never appears in the submitted zip.

OPENAI_API_KEY=sk-your-key-here

# Model IDs, per capstone_build_plan.md §0.2 / §9 (confirmed 25 Aug 2026).
OPENAI_MODEL_AGENT=gpt-4o-mini
OPENAI_MODEL_JUDGE=gpt-4o

# LangSmith tracing -- attempted, then hard-disabled: live testing found it
# doesn't reliably redact AI-generated/tool-derived content before upload.
# These three vars are read but have NO EFFECT -- src/langsmith_tracing.py
# returns [] unconditionally now. See Phase_8/docs/08_deployment.md for the
# full investigation. Left here for reference, not because setting them does
# anything.
ENABLE_SAFE_LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=lsv2-your-langsmith-key-here
LANGCHAIN_PROJECT=bankassist-advisor
